// Evergreen dev harness (generated by `eg.py dev` from dev/evergreen-dev.cfg.in). DEV ONLY.
// Firefox ignores the first line of an autoconfig file, hence this comment.
(function () {
  try {
    // prefs/evergreen.js, applied as default prefs exactly as a real build ships them.
    @EVERGREEN_PREFS@

    // Dev-copy conveniences (updates off, Browser Toolbox available).
    @DEV_PREFS@

    // Serve Evergreen's sources from the repo, so edits only need a restart.
    const res = Services.io
      .getProtocolHandler("resource")
      .QueryInterface(Components.interfaces.nsIResProtocolHandler);
    res.setSubstitution("evergreen", Services.io.newURI("@COMPONENT_URL@"));
    res.setSubstitution("evergreen-l10n", Services.io.newURI("@LOCALES_URL@"));
    res.setSubstitution("evergreen-dev", Services.io.newURI("@DEV_URL@"));

    ChromeUtils.importESModule("resource://evergreen-dev/EvergreenDev.sys.mjs").EvergreenDev.start();
  } catch (e) {
    Components.utils.reportError(e);
  }
})();
