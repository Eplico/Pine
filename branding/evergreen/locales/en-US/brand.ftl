## Evergreen brand
##
## Evergreen is built from Firefox source code but is not Firefox, and must
## not use Mozilla's trademarks (https://www.mozilla.org/foundation/trademarks/policy/).

-brand-shorter-name = Evergreen
-brand-short-name = Evergreen
-brand-shortcut-name = Evergreen
-brand-full-name = Evergreen
# This brand name can be used in messages where the product name needs to
# remain unchanged across different versions.
-brand-product-name = Evergreen
# Strings using the vendor name describe Mozilla's services (accounts, add-ons,
# security lists), which Evergreen keeps using, so this stays "Mozilla".
-vendor-short-name = Mozilla
trademarkInfo = { " " }
