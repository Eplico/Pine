# Windows x86-64: Evergreen's primary platform.
# Build from the MozillaBuild shell; `eg.py bootstrap` installs clang-cl, the
# Windows SDK and the WASI sysroot used for sandboxed libraries.

ac_add_options --target=x86_64-pc-windows-msvc

# The default-browser agent is a scheduled task that reports which browser is
# the default back to Mozilla. Evergreen does not ship it.
ac_add_options --disable-default-browser-agent

# Updates (milestone M3): the Mozilla Maintenance Service only accepts updates
# signed by Mozilla, so Evergreen will need its own MAR keys and a decision on
# whether to ship a privileged update service at all. Until then, update with
# a new installer.
