# Evergreen build configuration shared by every platform.
#
# Rule (design doc §8.1): Evergreen keeps every protection Mozilla's own
# builds ship. Never add --disable-sandbox, --without-wasm-sandboxed-libraries,
# MOZ_REQUIRE_SIGNING=0, or anything else that weakens a release build.

ac_add_options --enable-application=browser
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-evergreen

# Identity: our own branding, binary name (evergreen.exe) and profile location
# (%APPDATA%\Mozilla\Evergreen), so Evergreen never shares a profile with an
# installed Firefox. (The vendor stays "Mozilla": since Firefox 157 it can only
# be changed by patching browser/moz.configure.)
ac_add_options --with-branding=browser/branding/evergreen
ac_add_options --with-app-name=evergreen
ac_add_options --with-app-basename=Evergreen

# Download Mozilla's own toolchains (clang, Rust, the Windows SDK, NSIS, the
# WASI sysroot for sandboxed libraries...) into ~/.mozbuild. Release source
# tarballs do not do this by default.
ac_add_options --enable-bootstrap

# Release configuration.
ac_add_options --enable-update-channel=release
ac_add_options --enable-release
ac_add_options --enable-optimize
ac_add_options --disable-debug

# Add-ons must be signed by addons.mozilla.org. This is already the default
# for release builds; stated so it cannot silently change.
export MOZ_REQUIRE_SIGNING=1

# No crash reports leave the machine (design doc §8.3). Telemetry reporting is
# not compiled in because MOZILLA_OFFICIAL is not set: do not set it, it also
# switches on Mozilla's own reporting endpoints.
ac_add_options --disable-crashreporter

# No updater until Evergreen has its own signed update files (milestone M3).
# Firefox's updater would otherwise ask Mozilla's update server about a
# product it does not know. Updating = installing a newer release.
ac_add_options --disable-updater

# Performance (not security): PGO + LTO make release builds faster but take
# much longer to build. Enable for published releases (milestone M3):
# export MOZ_PGO=1
# ac_add_options --enable-lto=cross
